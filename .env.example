# Papyrus environment (copy to .env)

APP_ENV=development

# Comma-separated browser origins for API CORS (required in production deploys)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real contact addresses for CrossRef, OpenAlex, and Unpaywall (required when APP_ENV=production)
CROSSREF_MAILTO=you@yourdomain.com
OPENALEX_MAILTO=you@yourdomain.com
UNPAYWALL_EMAIL=you@yourdomain.com

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://papyrus:papyrus@localhost:5432/papyrus
PERSISTENCE_BACKEND=both

GROBID_URL=http://localhost:8070
GROBID_ENABLED=true

# Bulk ZIP jobs: use Celery worker (recommended with docker compose worker service)
USE_CELERY_BULK=true

# Optional API keys
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# APIFY_API_TOKEN=
# SEMANTIC_SCHOLAR_API_KEY=
# HUGGINGFACE_API_KEY=

NLI_REQUIRES_CLAIM_APPROVAL=true
NLI_BACKEND=auto
EMBEDDINGS_BACKEND=openai
