# API
DEBUG=false
CROSSREF_MAILTO=you@example.com
OPENALEX_MAILTO=you@example.com

# Optional keys
SEMANTIC_SCHOLAR_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
EXA_API_KEY=
HUGGINGFACE_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
# APIFY_ACTOR_ACADEMIC_MCP=nexgendata/academic-research-mcp-server

UNPAYWALL_EMAIL=you@example.com
ENABLE_DEEPSEEK=true
USE_CELERY_BULK=false
NLI_BACKEND=auto
# NLI_BACKEND=local requires: pip install -r requirements-optional.txt
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NLI_MODEL=llama3.2
# NLI_REQUIRES_CLAIM_APPROVAL=false

# Infrastructure (docker-compose defaults)
DATABASE_URL=postgresql+psycopg2://papyrus:papyrus@localhost:5432/papyrus
PERSISTENCE_BACKEND=both
REDIS_URL=redis://localhost:6379/0
GROBID_URL=http://localhost:8070
GROBID_ENABLED=true

UPLOAD_DIR=./data/uploads
