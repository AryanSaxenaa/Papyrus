# =============================================================================
# Papyrus environment template — copy to .env
# Full reference: docs/configuration.md
# =============================================================================
# PDF ingestion: PyMuPDF only (GROBID off; LLM PDF ingest off until prompts are ready)
# Intent + claims: LLM_BACKEND=deepseek (api.deepseek.com) OR openrouter (owl-alpha, etc.)
# NLI + embeddings: one HUGGINGFACE_API_KEY
# =============================================================================

APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg2://papyrus:papyrus@localhost:5432/papyrus
PERSISTENCE_BACKEND=both

REDIS_URL=redis://localhost:6379/0

FILE_STORAGE_BACKEND=local
FILE_STORAGE_ROOT=./data

USE_CELERY_BACKGROUND=true
USE_CELERY_BULK=true

GROBID_ENABLED=false
GROBID_URL=http://localhost:8070

CROSSREF_MAILTO=you@yourdomain.com
OPENALEX_MAILTO=you@yourdomain.com
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=you@yourdomain.com

MAX_UPLOAD_MB=50

# --- LLM: intent + claim extraction (not PDF bibliography) ---
# DeepSeek-hosted models (e.g. deepseek-v4-flash) — use LLM_BACKEND=deepseek
LLM_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ENABLE_DEEPSEEK=true

# OpenRouter-hosted models (owl-alpha, nemotron, …) — use LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Full-PDF LLM bibliography (hallucination risk — keep false until engineered)
ENABLE_LLM_PDF_INGESTION=false

# --- Hugging Face: NLI + embeddings ---
HUGGINGFACE_API_KEY=
NLI_BACKEND=hf
NLI_REQUIRES_CLAIM_APPROVAL=true
EMBEDDINGS_BACKEND=snowflake
SNOWFLAKE_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5

SEMANTIC_SCHOLAR_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

SYNC_RELATIONAL_AUDITS=true
USE_RELATIONAL_READ=true

# --- SerpApi Scholar witness ---
PAPYRUS_MODE=live
SERPAPI_ENABLED=true
SERPAPI_API_KEY=
SERPAPI_SCOPE=residual
SERPAPI_MAX_CREDITS_PER_AUDIT=40
SERPAPI_MONTHLY_HARD_CAP=240
SERPAPI_MAX_PER_HOUR=40
SERPAPI_CACHE_TTL_HOURS=168
SERPAPI_NO_CACHE=false
REPLAY_SET=demo-a
REPLAY_SPEEDUP=20
PUBLIC_DEMO_MODE=false
LIVE_ACCESS_CODE=
SERVE_FRONTEND=false
STATIC_DIR=./static
FILE_RETENTION_DAYS=7

# VITE_API_BASE_URL=
