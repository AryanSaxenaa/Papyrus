# Copy to frontend/.env.local (gitignored)
#
# Local dev: leave empty — Vite proxies /api → http://127.0.0.1:8000
# Cloud Run: set to your API service URL (no trailing slash)

VITE_API_BASE_URL=

# Optional: override proxy target when running npm run dev without empty VITE_API_BASE_URL
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
