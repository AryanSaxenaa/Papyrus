FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM python:3.12-slim AS app
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libmupdf-dev build-essential && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
COPY backend/tests/fixtures/replay/ /app/data/audits/fixtures/
COPY --from=web /web/dist /app/static
ENV AUDIT_DATA_DIR=/app/data/audits
ENV SERVE_FRONTEND=true STATIC_DIR=/app/static PYTHONUNBUFFERED=1
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
