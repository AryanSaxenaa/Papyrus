# Copy to deploy/cloudrun/.env (gitignored) — production Cloud Run deploy
# Docs: docs/cloudrun-deployment.md

# Global ID "papyrus" is usually taken; this repo deploys to papyrus-audit
GCP_PROJECT_ID=papyrus-audit
GCP_REGION=us-central1

# Run once before first deploy: INIT_DB=1 .\deploy\cloudrun\deploy.ps1
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379

GCS_BUCKET=papyrus-data-your-gcp-project-id
GCS_PREFIX=papyrus

# Comma-separated if you use both Cloud Run hostname styles (hash and project-number URLs)
CORS_ORIGINS=https://papyrus-web-XXXXXXXX-uc.a.run.app,https://papyrus-web-PROJECT_NUMBER.us-central1.run.app

APP_ENV=production
PERSISTENCE_BACKEND=postgres
FILE_STORAGE_BACKEND=gcs
USE_CELERY_BACKGROUND=true
USE_CELERY_BULK=true
AUDIT_DATA_DIR=/tmp/papyrus-data

GROBID_ENABLED=false
ENABLE_LLM_PDF_INGESTION=false

LLM_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ENABLE_DEEPSEEK=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/owl-alpha

HUGGINGFACE_API_KEY=
NLI_BACKEND=hf
EMBEDDINGS_BACKEND=snowflake
NLI_REQUIRES_CLAIM_APPROVAL=true

SYNC_RELATIONAL_AUDITS=true
USE_RELATIONAL_READ=true

CROSSREF_MAILTO=you@yourdomain.com
OPENALEX_MAILTO=you@yourdomain.com
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=you@yourdomain.com

# Optional resolvers (Apify: arXiv fallbacks only — not OpenAlex/Europe PMC)
SEMANTIC_SCHOLAR_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

# Optional: INIT_DB=1 on first deploy only
